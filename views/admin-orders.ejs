<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Заказы</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
      <a href="/admin">Обзор</a>
      <a href="/admin/cities">Города</a>
      <a href="/admin/categories">Категории</a>
      <a href="/admin/shops">Магазины</a>
      <a href="/admin/products">Товары</a>
      <a href="/admin/calc-settings">Калькулятор</a>
      <a href="/admin/orders" class="is-active">Заказы</a>
      <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Заказы</h1>

    <% if (!orders.length) { %>
      <p style="color:#6B6B6B;">Заказов пока нет.</p>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Дата</th>
            <th>Гостей</th>
            <th>Часов</th>
            <th>Мероприятие</th>
            <th>Без алкоголя</th>
            <th>Сумма</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><%= o.id %></td>
              <td><%= new Date(o.createdAt).toLocaleString('ru-RU') %></td>
              <td><%= o.guests %></td>
              <td><%= o.hours %></td>
              <td><%= o.eventType || '—' %></td>
              <td><%= o.noAlcohol ? 'Да' : 'Нет' %></td>
              <td><%= Number(o.total).toFixed(2) %> ₽</td>
              <td>
                <form method="POST" action="/admin/orders/<%= o.id %>/delete" onsubmit="return confirm('Удалить заказ?')">
                  <button type="submit" class="admin-btn-delete">Удалить</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>