<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Регионы</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
        <a href="/admin">Обзор</a>
        <a href="/admin/regions" class="is-active">Регионы</a>
        <a href="/admin/cities">Города</a>
        <a href="/admin/categories">Категории</a>
        <a href="/admin/shops">Магазины</a>
        <a href="/admin/products">Товары</a>
        <a href="/admin/delivery">Партнеры</a>
        <a href="/admin/promo">Промокоды</a>
        <a href="/admin/calc-settings">Калькулятор</a>
        <a href="/admin/orders">Заказы</a>
        <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Регионы</h1>

    <% if (error) { %>
      <div class="admin-alert"><%= error %></div>
    <% } %>

    <form class="admin-form" method="POST" action="/admin/regions">
      <input type="text" name="name" placeholder="Название региона" required>
      <input type="number" name="markup" placeholder="Наценка, %" step="0.1" value="0">
      <button type="submit">Добавить</button>
    </form>

    <div class="admin-search">
      <input type="text" id="tableSearch" placeholder="Поиск по названию...">
      <span class="admin-search__count" id="searchCount"></span>
    </div>

    <table class="admin-table" id="dataTable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Название</th>
          <th>Наценка</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% regions.forEach(r => { %>
          <tr data-id="<%= r.id %>">
            <td><%= r.id %></td>
            <td class="row-view"><span class="cell-name"><%= r.name %></span></td>
            <td class="row-view"><span class="cell-markup"><%= r.markup %> %</span></td>
            <td class="row-view admin-actions">
              <button type="button" class="admin-btn-edit" onclick="editRow(<%= r.id %>)">Изменить</button>
              <form method="POST" action="/admin/regions/<%= r.id %>/delete" onsubmit="return confirm('Удалить регион <%= r.name %>?')">
                <button type="submit" class="admin-btn-delete">Удалить</button>
              </form>
            </td>

            <td class="row-edit" colspan="4">
              <form method="POST" action="/admin/regions/<%= r.id %>/edit" class="admin-edit-form">
                <input type="text" name="name" value="<%= r.name %>" required>
                <input type="number" name="markup" value="<%= r.markup %>" step="0.1">
                <button type="submit" class="admin-btn-save">Сохранить</button>
                <button type="button" class="admin-btn-cancel" onclick="cancelEdit(<%= r.id %>)">Отмена</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <script src="/js/admin.js"></script>
</body>
</html>