<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Категории</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
      <a href="/admin">Обзор</a>
      <a href="/admin/cities">Города</a>
      <a href="/admin/categories" class="is-active">Категории</a>
      <a href="/admin/shops">Магазины</a>
      <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Категории</h1>

    <form class="admin-form" method="POST" action="/admin/categories">
      <input type="text" name="name" placeholder="Название" required>
      <input type="text" name="slug" placeholder="Slug (латиница)">
      <input type="number" name="count" placeholder="Товаров" min="0">
      <button type="submit">Добавить</button>
    </form>

    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Название</th>
          <th>Slug</th>
          <th>Товаров</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(cat => { %>
          <tr>
            <td><%= cat.id %></td>
            <td><%= cat.name %></td>
            <td><%= cat.slug %></td>
            <td><%= cat.count %></td>
            <td>
              <form method="POST" action="/admin/categories/<%= cat.id %>/delete" onsubmit="return confirm('Удалить?')">
                <button type="submit" class="admin-btn-delete">Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>