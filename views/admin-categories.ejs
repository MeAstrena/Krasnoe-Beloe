<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Категории</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
      <a href="/admin">Обзор</a>
      <a href="/admin/cities">Города</a>
      <a href="/admin/categories" class="is-active">Категории</a>
      <a href="/admin/shops">Магазины</a>
      <a href="/admin/products">Товары</a>
      <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Категории</h1>

    <% if (error) { %>
      <div class="admin-alert"><%= error %></div>
    <% } %>

    <form class="admin-form" method="POST" action="/admin/categories">
      <input type="text" name="name" placeholder="Название" required>
      <input type="text" name="slug" placeholder="Slug (латиница)">
      <input type="number" name="count" placeholder="Товаров" min="0">
      <button type="submit">Добавить</button>
    </form>

    <div class="admin-search">
      <input type="text" id="tableSearch" placeholder="Поиск по названию...">
      <span class="admin-search__count" id="searchCount"></span>
    </div>

    <table class="admin-table" id="dataTable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Название</th>
          <th>Slug</th>
          <th>Товаров</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% categories.forEach(cat => { %>
          <tr data-id="<%= cat.id %>">
            <td><%= cat.id %></td>
            <td class="row-view"><span class="cell-name"><%= cat.name %></span></td>
            <td class="row-view"><span class="cell-slug"><%= cat.slug %></span></td>
            <td class="row-view"><span class="cell-count"><%= cat.count %></span></td>
            <td class="row-view admin-actions">
              <button type="button" class="admin-btn-edit" onclick="editRow(<%= cat.id %>)">Изменить</button>
              <form method="POST" action="/admin/categories/<%= cat.id %>/delete" onsubmit="return confirm('Удалить категорию <%= cat.name %>?')">
                <button type="submit" class="admin-btn-delete">Удалить</button>
              </form>
            </td>

            <td class="row-edit" colspan="5">
              <form method="POST" action="/admin/categories/<%= cat.id %>/edit" class="admin-edit-form">
                <input type="text" name="name" value="<%= cat.name %>" required>
                <input type="text" name="slug" value="<%= cat.slug %>">
                <input type="number" name="count" value="<%= cat.count %>" min="0">
                <button type="submit" class="admin-btn-save">Сохранить</button>
                <button type="button" class="admin-btn-cancel" onclick="cancelEdit(<%= cat.id %>)">Отмена</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <script src="/js/admin.js"></script>
</body>
</html>