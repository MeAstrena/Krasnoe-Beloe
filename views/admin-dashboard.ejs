<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Обзор</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
      <a href="/admin" class="is-active">Обзор</a>
      <a href="/admin/regions">Регионы</a>
      <a href="/admin/cities">Города</a>
      <a href="/admin/categories">Категории</a>
      <a href="/admin/shops">Магазины</a>
      <a href="/admin/products">Товары</a>
      <a href="/admin/delivery">Партнеры</a>
      <a href="/admin/promo">Промокоды</a>
      <a href="/admin/calc-settings">Калькулятор</a>
      <a href="/admin/orders">Заказы</a>
      <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Обзор</h1>
    <div class="admin-stats">
      <div class="admin-stat">
        <div class="admin-stat__value"><%= regions %></div>
        <div class="admin-stat__label">Регионов</div>
      </div>
      <div class="admin-stat">
        <div class="admin-stat__value"><%= cities %></div>
        <div class="admin-stat__label">Городов</div>
      </div>
      <div class="admin-stat">
        <div class="admin-stat__value"><%= categories %></div>
        <div class="admin-stat__label">Категорий</div>
      </div>
      <div class="admin-stat">
        <div class="admin-stat__value"><%= shops %></div>
        <div class="admin-stat__label">Магазинов</div>
      </div>
      <div class="admin-stat">
        <div class="admin-stat__value"><%= products %></div>
        <div class="admin-stat__label">Товаров</div>
      </div>
      <div class="admin-stat">
        <div class="admin-stat__value"><%= partners %></div>
        <div class="admin-stat__label">Партнёров доставки</div>
      </div>
      <div class="admin-stat">
        <div class="admin-stat__value"><%= promos %></div>
        <div class="admin-stat__label">Промокодов</div>
      </div>
      <div class="admin-stat">
        <div class="admin-stat__value"><%= orders %></div>
        <div class="admin-stat__label">Заказов</div>
      </div>
    </div>
  </main>
</body>
</html>