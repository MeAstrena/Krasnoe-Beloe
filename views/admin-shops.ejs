<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Магазины</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
      <a href="/admin">Обзор</a>
      <a href="/admin/regions">Регионы</a>
      <a href="/admin/cities">Города</a>
      <a href="/admin/categories">Категории</a>
      <a href="/admin/shops" class="is-active">Магазины</a>
      <a href="/admin/products">Товары</a>
      <a href="/admin/delivery">Партнеры</a>
      <a href="/admin/promo">Промокоды</a>
      <a href="/admin/calc-settings">Калькулятор</a>
      <a href="/admin/orders">Заказы</a>
      <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Магазины</h1>

    <% if (error) { %>
      <div class="admin-alert"><%= error %></div>
    <% } %>

    <% if (newPassword && newLogin) { %>
      <div class="admin-credentials">
        <div class="admin-credentials__title">
          Магазин #<%= shopId %> создан. Данные для менеджера:
        </div>
        <div class="admin-credentials__row">
          <span class="admin-credentials__label">Логин:</span>
          <code class="admin-credentials__value" id="credLogin"><%= newLogin %></code>
          <button type="button" class="admin-credentials__copy" onclick="copyCred('credLogin')">Копировать</button>
        </div>
        <div class="admin-credentials__row">
          <span class="admin-credentials__label">Пароль:</span>
          <code class="admin-credentials__value" id="credPassword"><%= newPassword %></code>
          <button type="button" class="admin-credentials__copy" onclick="copyCred('credPassword')">Копировать</button>
        </div>
        <div class="admin-credentials__warning">
          ⚠️ Сохраните пароль — больше он не будет показан. Если потеряете, используйте «Сбросить пароль».
        </div>
      </div>
    <% } %>

    <form class="admin-form--shops" method="POST" action="/admin/shops">
      <select name="cityId" required>
        <option value="">Выберите город</option>
        <% cities.forEach(city => { %>
          <option value="<%= city.id %>"><%= city.name %></option>
        <% }) %>
      </select>

      <input type="text" name="address" placeholder="Адрес" required>
      <input type="text" name="metro" placeholder="Район / метро">

      <div class="admin-hours">
        <span class="admin-hours__label">Время работы:</span>
        <span class="admin-hours__word">с</span>
        <input type="time" name="hoursFrom" value="08:00" step="60" required>
        <span class="admin-hours__word">по</span>
        <input type="time" name="hoursTo" value="23:00" step="60" required>
      </div>

      <button type="submit">Добавить</button>
    </form>

    <p class="admin-hint">
      При добавлении магазина автоматически создаётся аккаунт менеджера с логином <code>shop-&lt;id&gt;@kb.ru</code>.
      Данные показываются один раз после создания.
    </p>

    <div class="admin-search">
      <input type="text" id="tableSearch" placeholder="Поиск по городу, адресу или логину...">
      <span class="admin-search__count" id="searchCount"></span>
    </div>

    <table class="admin-table" id="dataTable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Город</th>
          <th>Адрес</th>
          <th>Часы</th>
          <th>Район</th>
          <th>Логин менеджера</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% shops.forEach(shop => { %>
          <% const parts = (shop.hours || '').split('–'); %>
          <% const hFrom = parts[0] || '08:00'; %>
          <% const hTo = parts[1] || '23:00'; %>
          <tr data-id="<%= shop.id %>">
            <td><%= shop.id %></td>
            <td class="row-view"><span class="cell-city"><%= shop.cityName %></span></td>
            <td class="row-view"><span class="cell-address"><%= shop.address %></span></td>
            <td class="row-view"><span class="cell-hours"><%= shop.hours %></span></td>
            <td class="row-view"><span class="cell-metro"><%= shop.metro || '—' %></span></td>
            <td class="row-view">
              <code class="shop-login"><%= shop.managerLogin %></code>
            </td>
            <td class="row-view admin-actions">
              <button type="button" class="admin-btn-edit" onclick="editRow(<%= shop.id %>)">Изменить</button>
              <form method="POST" action="/admin/shops/<%= shop.id %>/reset-password" onsubmit="return confirm('Сбросить пароль менеджера? Старый перестанет работать.')" style="display:inline">
                <button type="submit" class="admin-btn-reset">Сбросить пароль</button>
              </form>
              <form method="POST" action="/admin/shops/<%= shop.id %>/delete" onsubmit="return confirm('Удалить магазин и его менеджера?')" style="display:inline">
                <button type="submit" class="admin-btn-delete">Удалить</button>
              </form>
            </td>

            <td class="row-edit" colspan="7">
              <form method="POST" action="/admin/shops/<%= shop.id %>/edit" class="admin-edit-form">
                <select name="cityId" required>
                  <% cities.forEach(city => { %>
                    <option value="<%= city.id %>" <%= Number(city.id) === Number(shop.cityId) ? 'selected' : '' %>><%= city.name %></option>
                  <% }) %>
                </select>
                <input type="text" name="address" value="<%= shop.address %>" required>
                <input type="text" name="metro" value="<%= shop.metro || '' %>" placeholder="Район / метро">
                <div class="admin-hours">
                  <span class="admin-hours__word">с</span>
                  <input type="time" name="hoursFrom" value="<%= hFrom %>" step="60" required>
                  <span class="admin-hours__word">по</span>
                  <input type="time" name="hoursTo" value="<%= hTo %>" step="60" required>
                </div>
                <button type="submit" class="admin-btn-save">Сохранить</button>
                <button type="button" class="admin-btn-cancel" onclick="cancelEdit(<%= shop.id %>)">Отмена</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <script>
    function copyCred(id) {
      const el = document.getElementById(id);
      if (!el) return;
      const text = el.textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          const btn = el.parentElement.querySelector('.admin-credentials__copy');
          if (btn) {
            const original = btn.textContent;
            btn.textContent = '✓ Скопировано';
            setTimeout(function () { btn.textContent = original; }, 1500);
          }
        });
      } else {
        const range = document.createRange();
        range.selectNodeContents(el);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        try { document.execCommand('copy'); } catch (e) {}
      }
    }
  </script>
  <script src="/js/admin.js"></script>
</body>
</html>