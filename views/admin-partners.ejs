<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Доставка</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
      <a href="/admin">Обзор</a>
      <a href="/admin/regions">Регионы</a>
      <a href="/admin/cities">Города</a>
      <a href="/admin/categories">Категории</a>
      <a href="/admin/shops">Магазины</a>
      <a href="/admin/products">Товары</a>
      <a href="/admin/partners" class="is-active">Доставка</a>
      <a href="/admin/calc-settings">Калькулятор</a>
      <a href="/admin/orders">Заказы</a>
      <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Партнёры доставки</h1>

    <% if (error) { %>
      <div class="admin-alert"><%= error %></div>
    <% } %>

    <form class="admin-form--grid" method="POST" action="/admin/partners">
      <input type="text" name="name" placeholder="Название (Яндекс.Лавка)" required>
      <input type="text" name="description" placeholder="Краткое описание">
      <input type="url" name="url" placeholder="Ссылка https://...">
      <input type="text" name="logo" placeholder="URL логотипа (опционально)">
      <button type="submit">Добавить</button>
    </form>

    <div class="admin-search">
      <input type="text" id="tableSearch" placeholder="Поиск по названию...">
      <span class="admin-search__count" id="searchCount"></span>
    </div>

    <table class="admin-table" id="dataTable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Название</th>
          <th>Описание</th>
          <th>Ссылка</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% partners.forEach(p => { %>
          <tr data-id="<%= p.id %>">
            <td><%= p.id %></td>
            <td class="row-view"><span class="cell-name"><%= p.name %></span></td>
            <td class="row-view"><span class="cell-desc"><%= p.description || '—' %></span></td>
            <td class="row-view">
              <% if (p.url) { %>
                <a href="<%= p.url %>" target="_blank" rel="noopener" style="color:#A52A2A;"><%= p.url %></a>
              <% } else { %>
                —
              <% } %>
            </td>
            <td class="row-view admin-actions">
              <button type="button" class="admin-btn-edit" onclick="editRow(<%= p.id %>)">Изменить</button>
              <form method="POST" action="/admin/partners/<%= p.id %>/delete" onsubmit="return confirm('Удалить партнёра <%= p.name %>?')">
                <button type="submit" class="admin-btn-delete">Удалить</button>
              </form>
            </td>

            <td class="row-edit" colspan="5">
              <form method="POST" action="/admin/partners/<%= p.id %>/edit" class="admin-edit-form admin-edit-form--grid">
                <input type="text" name="name" value="<%= p.name %>" required>
                <input type="text" name="description" value="<%= p.description || '' %>" placeholder="Описание">
                <input type="url" name="url" value="<%= p.url || '' %>" placeholder="Ссылка">
                <input type="text" name="logo" value="<%= p.logo || '' %>" placeholder="URL логотипа">
                <button type="submit" class="admin-btn-save">Сохранить</button>
                <button type="button" class="admin-btn-cancel" onclick="cancelEdit(<%= p.id %>)">Отмена</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <script src="/js/admin.js"></script>
</body>
</html>