<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — Города</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <header class="admin-header">
    <div class="admin-header__logo">КБ Админка</div>
    <nav class="admin-nav">
      <a href="/admin">Обзор</a>
      <a href="/admin/cities" class="is-active">Города</a>
      <a href="/admin/categories">Категории</a>
      <a href="/admin/shops">Магазины</a>
      <a href="/admin/products">Товары</a>
      <a href="/admin/logout" class="admin-nav__logout">Выйти</a>
    </nav>
  </header>

  <main class="admin-main">
    <h1>Города</h1>

    <% if (error) { %>
      <div class="admin-alert"><%= error %></div>
    <% } %>

    <form class="admin-form" method="POST" action="/admin/cities">
      <input type="text" name="name" placeholder="Название города" required>
      <input type="number" name="shopsCount" placeholder="Кол-во магазинов" min="0">
      <button type="submit">Добавить</button>
    </form>

    <div class="admin-search">
      <input type="text" id="tableSearch" placeholder="Поиск по названию...">
      <span class="admin-search__count" id="searchCount"></span>
    </div>

    <table class="admin-table" id="dataTable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Название</th>
          <th>Магазинов</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% cities.forEach(city => { %>
          <tr data-id="<%= city.id %>">
            <td><%= city.id %></td>
            <td class="row-view">
              <span class="cell-name"><%= city.name %></span>
            </td>
            <td class="row-view">
              <span class="cell-shops"><%= city.shops %></span>
            </td>
            <td class="row-view admin-actions">
              <button type="button" class="admin-btn-edit" onclick="editRow(<%= city.id %>)">Изменить</button>
              <form method="POST" action="/admin/cities/<%= city.id %>/delete" onsubmit="return confirm('Удалить город <%= city.name %>?')">
                <button type="submit" class="admin-btn-delete">Удалить</button>
              </form>
            </td>

            <td class="row-edit" colspan="4">
              <form method="POST" action="/admin/cities/<%= city.id %>/edit" class="admin-edit-form">
                <input type="text" name="name" value="<%= city.name %>" required>
                <input type="number" name="shopsCount" value="<%= city.shops %>" min="0">
                <button type="submit" class="admin-btn-save">Сохранить</button>
                <button type="button" class="admin-btn-cancel" onclick="cancelEdit(<%= city.id %>)">Отмена</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <script src="/js/admin.js"></script>
</body>
</html>